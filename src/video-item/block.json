{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "vertifeed/video",
	"version": "1.0.0",
	"title": "VertiFeed Video",
	"category": "media",
	"icon": "video-alt3",
	"description": "A single video from the Media Library.",
	"parent": [ "vertifeed/gallery" ],
	"textdomain": "vertifeed",
	"attributes": {
		"videoId": {
			"type": "number",
			"default": 0
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"caption": {
			"type": "string",
			"default": ""
		},
		"posterId": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"html": false,
		"reusable": false,
		"lock": false
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
